SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SYNC_INTERVAL_MS=30000

# Optional: If you have multiple branches, set this to the exact name of the branch
# this agent is running at (e.g. "Main Branch"). If empty, it syncs all locations.
LOCATION_NAME=
