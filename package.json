{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --mode development",
    "build": "vite build",
    "check:jsx": "node scripts/check-jsx.mjs",
    "lint": "eslint .",
    "test:a11y": "eslint .",
    "preview": "vite preview",
    "copy-models": "node -e \"const fs=require('fs');const src='node_modules/@vladmandic/face-api/model';const dst='public/models';if(!fs.existsSync(dst))fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(src+'/'+f,dst+'/'+f));console.log('Models copied.');\"",
    "postinstall": "npm run copy-models"
  },
  "dependencies": {
    "@capacitor-community/privacy-screen": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.112.4",
    "@vladmandic/face-api": "^1.7.15",
    "dexie": "^4.4.5",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "jsqr": "^1.4.0",
    "lovable-tagger": "^1.3.3",
    "lucide-react": "^0.577.0",
    "onnxruntime-web": "^1.29.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^15.15.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^4.5.14",
    "vitest": "^3.2.7"
  }
}
